# Local development only. Use dedicated credentials for a real deployment.
RISK_DATABASE_URL=postgresql+psycopg://risk_local:risk_local@localhost:55432/risk_platform
# Generate a long random token. An empty value disables all case/model API access.
RISK_API_TOKEN=
# This initial API authenticates one local operator only; no shared deployment yet.
RISK_OPERATOR_ID=local-investigator
RISK_ENVIRONMENT=local
