# Local development only. Use dedicated credentials for a real deployment.
RISK_DATABASE_URL=postgresql+psycopg://risk_local:risk_local@localhost:55432/risk_platform
# Generate a long random token. An empty value disables all case/model API access.
RISK_API_TOKEN=
# This initial API authenticates one local operator only; no shared deployment yet.
RISK_OPERATOR_ID=local-investigator
RISK_ENVIRONMENT=local

# Local guardrail configuration (all limits are per process).
RISK_OPERATOR_ROLE=investigator
RISK_ALLOWED_DOMAINS=["ieee_cis","home_credit","elliptic"]
RISK_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]","test"]
RISK_MAX_BODY_BYTES=65536
RISK_MAX_HEADER_BYTES=16384
RISK_BODY_TIMEOUT_SECONDS=5
RISK_REQUESTS_PER_MINUTE=120
RISK_RATE_LIMIT_MAX_CLIENTS=1024
RISK_MAX_CONCURRENT_REQUESTS=20
RISK_MODEL_TIMEOUT_SECONDS=5
RISK_MODEL_FAILURE_THRESHOLD=3
RISK_MODEL_COOLDOWN_SECONDS=30
RISK_WRITES_ENABLED=true
RISK_SCORING_ENABLED=true
RISK_DOCS_ENABLED=true
# Optional JSON mapping of domain to a checksum-pinned ONNX manifest.
RISK_ONNX_MANIFESTS={}
